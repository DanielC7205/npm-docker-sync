# NPMplus credentials (https://github.com/ZoeyVid/NPMplus)
# These are applied as INITIAL_ADMIN_* on first start of the npmplus container
# and used by npm-docker-sync to authenticate to the API.
NPM_EMAIL=admin@example.org
NPM_PASSWORD=changeme

# Optional timezone for NPMplus
# TZ=UTC

# Docker/Podman socket mounted into npm-docker-sync
# Docker Desktop (Linux/Windows): leave default
# DOCKER_SOCKET=/var/run/docker.sock
#
# Podman Desktop on macOS (required — the /var/run/docker.sock symlink is not usable in containers):
DOCKER_SOCKET=/Users/YOUR_USER/.local/share/containers/podman/machine/podman.sock
