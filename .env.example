# NPMplus credentials (https://github.com/ZoeyVid/NPMplus)
# These are applied as INITIAL_ADMIN_* on first start of the npmplus container
# and used by npm-docker-sync to authenticate to the API.
NPM_EMAIL=admin@example.org
NPM_PASSWORD=changeme

# Optional timezone for NPMplus
# TZ=UTC

# Docker/Podman socket mounted into npm-docker-sync
# Docker Desktop (Linux/Windows): leave default
# DOCKER_SOCKET=/var/run/docker.sock
#
# Podman Desktop on macOS (required — the /var/run/docker.sock symlink is not usable in containers):
DOCKER_SOCKET=/Users/YOUR_USER/.local/share/containers/podman/machine/podman.sock

# Persistent SQLite settings / route overrides / tunnels
# SQLITE_PATH=/data/npm-docker-sync.db

# Web UI auth (required to change settings from the UI)
# WEB_UI_TOKEN=changeme

# OIDC for Web UI (optional; set at container start to register the middleware)
# OIDC_AUTHORITY=https://auth.example.com/application/o/npm-docker-sync/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email

# Komodo deep links (optional)
# KOMODO_URL=https://komodo.example.com
# KOMODO_SERVER=myserver
# KOMODO_API_KEY=
# KOMODO_API_SECRET=

# Dev tunnels (optional; NPMplus must reach TUNNEL_FORWARD_HOST)
# TUNNEL_BASE_DOMAIN=tunnels.example.com
# TUNNEL_FORWARD_HOST=100.x.y.z
# TUNNEL_DEFAULT_TTL_MINUTES=120
# TUNNEL_API_TOKEN=

# Short aliases → FQDN (proxy.aliases=home → home.example.com)
# PROXY_BASE_DOMAIN=example.com
# Auto-create proxies for any container with an exposed port (requires PROXY_BASE_DOMAIN)
# AUTO_BRIDGE_EXPOSED=false
# AUTO_BRIDGE_EXCLUDE=npmplus,npm-docker-sync,nginx-proxy-manager

# TLS: fallback cert ID when Force SSL is on and no domain match
# NPM_PROXY_DEFAULT_CERTIFICATE_ID=1
# Domain → cert map (newline/comma separated pattern=id). Used by sync + auto-bridge.
# CERT_DOMAIN_MAP=*.example.com=1
# app.example.com=2

# NPMplus auth_request default for proxied apps
# AUTH_REQUEST_DEFAULT=none
# AUTH_REQUEST_UPSTREAM=
